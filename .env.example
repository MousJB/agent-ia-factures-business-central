# ---------------------------------------------------------------
# Agent IA de saisie de factures fournisseurs — configuration
# Copier ce fichier en .env puis adapter.
# ---------------------------------------------------------------

# ERP : "mock" (données CRONUS locales, aucun compte requis) | "business_central"
ERP_MODE=mock

# LLM : "offline" (simulateur déterministe, sans clé, pour tester la démo)
#     | "anthropic" | "openai" | "azure_openai"
LLM_PROVIDER=offline

# Nombre max d'allers-retours outil <-> LLM
AGENT_MAX_ITERATIONS=15

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Repli serveur automatique si une requête est refusée par les garde-fous
ANTHROPIC_FALLBACKS=true

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<ressource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Nom du déploiement (et non du modèle)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Business Central (ERP_MODE=business_central) ---
# App registration Entra ID avec la permission applicative
# "Dynamics 365 Business Central > API.ReadWrite.All" (consentement admin),
# puis l'app déclarée dans BC (page "Microsoft Entra Applications").
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=Production
# Optionnel : sinon la première société trouvée est utilisée
BC_COMPANY_ID=
BC_COMPANY_NAME=CRONUS France S.A.
# Compte général utilisé pour les lignes sans article identifié
BC_DEFAULT_GL_ACCOUNT=607000
